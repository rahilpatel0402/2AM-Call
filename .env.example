# Copy this file to .env and fill in values. Never commit .env.

# --- Claude ---
LLM_PROVIDER=bedrock         # bedrock | anthropic
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=            # latest Claude Sonnet in the lab account; may need a cross-region inference profile id (us.anthropic....)
ANTHROPIC_API_KEY=           # fallback only if Bedrock access fails
ANTHROPIC_MODEL=claude-sonnet-5-5   # optional, used only when LLM_PROVIDER=anthropic

# --- ElevenLabs ---
ELEVENLABS_API_KEY=

# --- Daytona ---
DAYTONA_API_KEY=

# --- Arize ---
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=two-am-call

# --- SurrealDB Agent Memory (old product name Spectron) ---
SPECTRON_ENDPOINT=           # context host from SurrealDB Studio, e.g. https://<your-context-host>
SPECTRON_CONTEXT=            # context ID shown in Studio (not the display name)
SPECTRON_API_KEY=            # starts with sp-

# --- Anchor (stretch module S3 only) ---
ANCHOR_API_KEY=
